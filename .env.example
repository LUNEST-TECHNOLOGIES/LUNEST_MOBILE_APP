# Lunest Mobile App - Environment Variables
# Copy this file to .env.local and update with your values

# API Configuration
EXPO_PUBLIC_API_URL=https://api.lunest.app
EXPO_PUBLIC_API_TIMEOUT=30000

# Feature Flags
EXPO_PUBLIC_ENABLE_DEBUG_MODE=false
EXPO_PUBLIC_ENABLE_ANALYTICS=true

# Third-party Services
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_FIREBASE_CONFIG=

# App Configuration
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0

# Note: Variables prefixed with EXPO_PUBLIC_ are accessible in the app
# Variables without the prefix are server-side only
